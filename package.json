    "check": "node scripts/check.js",
    "doctor": "node src/cli.js doctor",
    "demo": "node scripts/demo.js",
    "demo:agent": "node scripts/demo.js agent",
    "demo:plan": "node scripts/demo.js plan",
    "demo:suite": "node scripts/demo.js suite",
    "demo:strict": "node scripts/demo.js strict"
  }

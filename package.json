{
  "name": "skill-update-firewall",
  "version": "0.2.0",
  "description": "Sandbox, compare, review and pin agent skill updates",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "skillwall": "src/cli.js"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "examples",
    "scripts",
    "CONTRIBUTING.md"
  ],
  "scripts": {
